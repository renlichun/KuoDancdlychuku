<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="45dp"
        android:background="#84c1ff"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        >

        <ImageView
            android:id="@+id/finish_back"
            android:layout_width="70dp"
            android:layout_height="40dp"
            android:src="@drawable/goback" /><!-- 返回 -->

        <TextView
            android:id="@+id/textView1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:textSize="25sp"
            android:textColor="#ffffff"
            android:text="物料规格的货位信息" />


    </RelativeLayout>



    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/bianm_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="编码:"
            android:layout_marginLeft="15dp"
            android:layout_centerVertical="true"
            />

        <TextView
            android:id="@+id/cinvCode_tv2"
            android:layout_toRightOf="@id/bianm_tv"
            android:layout_width="200dp"
            android:layout_height="30dp"
            android:layout_marginLeft="15dp"
            android:layout_centerVertical="true"
            android:background="@drawable/tv_bg"
            android:gravity="center"
            />


    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/mingch_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="名称:"
            android:layout_marginLeft="15dp"
            android:layout_centerVertical="true"
            />

        <TextView
            android:id="@+id/cinvName_tv2"
            android:layout_toRightOf="@id/mingch_tv"
            android:layout_width="200dp"
            android:layout_height="30dp"
            android:layout_marginLeft="15dp"
            android:layout_centerVertical="true"
            android:background="@drawable/tv_bg"
            android:gravity="center"
            />


    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/gsgg_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="公司规格:"
            android:layout_marginLeft="15dp"
            android:layout_centerVertical="true"
            />

        <TextView
            android:id="@+id/cinvStd_tv2"
            android:layout_toRightOf="@id/gsgg_tv"
            android:layout_width="200dp"
            android:layout_height="30dp"
            android:layout_marginLeft="15dp"
            android:layout_centerVertical="true"
            android:background="@drawable/tv_bg"
            android:gravity="center"
            />
        <TextView
            android:id="@+id/stdyz_tv"
            android:layout_toRightOf="@id/cinvStd_tv2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginLeft="15dp"
            android:layout_centerVertical="true"
            />

    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/khth_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="客户图号:"
            android:layout_marginLeft="15dp"
            android:layout_centerVertical="true"
            />

        <TextView
            android:id="@+id/addCode_tv2"
            android:layout_toRightOf="@id/khth_tv"
            android:layout_width="200dp"
            android:layout_height="30dp"
            android:layout_marginLeft="15dp"
            android:layout_centerVertical="true"
            android:background="@drawable/tv_bg"
            android:gravity="center"
            />

        <!--<Button
            android:id="@+id/search_btn"
            android:layout_width="70dp"
            android:layout_height="30dp"
            android:background="@drawable/login_btn"
            android:layout_centerVertical="true"
            android:layout_alignParentRight="true"
            android:textColor="#ffffff"
            android:text="查询"
            android:gravity="center"
            android:layout_marginRight="15dp"
            android:textSize="15sp"/>-->


    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/ckshul_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="数量:"
            android:layout_marginLeft="15dp"
            android:layout_centerVertical="true"
            />

        <EditText
            android:id="@+id/outQtyn_tv2"
            android:layout_toRightOf="@id/ckshul_tv"
            android:layout_width="200dp"
            android:layout_height="30dp"
            android:layout_marginLeft="15dp"
            android:layout_centerVertical="true"
            android:background="@drawable/tv_bg"
            android:gravity="center"
            />

        <Button
            android:id="@+id/search_btn"
            android:layout_width="70dp"
            android:layout_height="30dp"
            android:background="@drawable/login_btn"
            android:layout_centerVertical="true"
            android:layout_alignParentRight="true"
            android:textColor="#ffffff"
            android:text="查询"
            android:gravity="center"
            android:layout_marginRight="15dp"
            android:textSize="15sp"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/ckcgshul_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="已出库数量:"
            android:layout_marginLeft="15dp"
            android:layout_centerVertical="true"
            />

        <TextView
            android:id="@+id/outQtyncg_tv2"
            android:layout_toRightOf="@id/ckcgshul_tv"
            android:layout_width="200dp"
            android:layout_height="30dp"
            android:layout_marginLeft="15dp"
            android:layout_centerVertical="true"
            android:background="@drawable/tv_bg"
            android:gravity="center"
            />


    </RelativeLayout>



    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#666666"/>



    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#666666"/>

    <!-- 这个引入的是另一个xml -->
    <android.support.v7.widget.RecyclerView
        android:id="@+id/recycleview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        />

    <EditText
        android:id="@+id/foucas_result1"
        android:layout_width="1dp"
        android:layout_height="1dp"
        >
        <requestFocus />
    </EditText>



</LinearLayout>